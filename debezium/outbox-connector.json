{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "plugin.name": "pgoutput",
  "database.hostname": "postgres",
  "database.port": "5432",
  "database.user": "myuser",
  "database.password": "secret",
  "database.dbname": "pagamentodb",
  "topic.prefix": "payment-api",
  "slot.name": "outbox",
  "publication.name": "outbox",
  "publication.autocreate.mode": "all_tables",
  "table.include.list": "public.outbox",
  "snapshot.mode": "no_data",
  "tombstones.on.delete": "false",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.storage.StringConverter",
  "transforms": "outbox",
  "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.outbox.table.field.event.id": "id_outbox",
  "transforms.outbox.table.field.event.key": "txt_chave",
  "transforms.outbox.table.field.event.payload": "txt_body",
  "transforms.outbox.route.by.field": "txt_topico",
  "transforms.outbox.route.topic.replacement": "${routedByValue}",
  "transforms.outbox.table.fields.additional.placement": "id_transacao:header:X-Id-Transacao",
  "transforms.outbox.table.expand.json.payload": "false"
}
